  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Run the synthetic workflow.",
      "html": "<button class=\"ds-primary\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 3 14 9-14 9z\" fill=\"currentColor\"/></svg>Run demo</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent;border-radius:7px;padding:10px 15px;font:600 12px/1.3 var(--font-public,'Public Sans'),sans-serif;white-space:nowrap;cursor:pointer;transition:background .16s,color .16s;background:var(--blue,#c7ef79);color:#18220e}.ds-primary:hover{background:#d6f99d}.ds-primary:focus-visible{outline:2px solid var(--blue,#c7ef79);outline-offset:4px}.ds-primary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Outline action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Open the selected finding for human review.",
      "html": "<button class=\"ds-outline\">Review finding<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent;border-radius:7px;padding:10px 15px;font:600 12px/1.3 var(--font-public,'Public Sans'),sans-serif;white-space:nowrap;cursor:pointer;transition:background .16s,color .16s;border-color:#555d48;background:#252c1e;color:#d3efb0}.ds-outline:hover{background:#323e27;border-color:#879c6b}.ds-outline:focus-visible{outline:2px solid var(--blue,#c7ef79);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none}}"
