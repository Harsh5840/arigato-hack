    {
      "name": "Evidence preview",
      "kind": "card",
      "refersTo": "panel",
      "description": "Compact before/after result with explicit synthetic and blocked labels.",
      "html": "<section class=\"ds-evidence\"><h2>Evidence preview</h2><h3>Cross-tenant invoice access</h3><span class=\"ds-fixture\">Synthetic demo fixture</span><dl><div><dt>Before</dt><dd>200 · unauthorized access</dd></div><div><dt>After</dt><dd>404 · access denied</dd></div></dl><p>Regression failed. Draft preparation is blocked until all required checks pass.</p></section>",
      "css": ".ds-evidence{max-width:355px;padding:20px;border:1px solid var(--line,#32352f);background:#1a1d17;border-radius:12px;color:var(--ink,#f1f1eb);font-family:var(--font-public,'Public Sans'),sans-serif}.ds-evidence h2{margin:0 0 16px;font-size:15px;font-weight:600}.ds-evidence h3{margin:0 0 9px;font-size:17px;line-height:1.35;font-weight:600;letter-spacing:-.02em}.ds-fixture{font-size:9px;padding:3px 6px;border:1px solid #3c4730;border-radius:4px;color:#b9c5aa;background:#252d1e}.ds-evidence dl{margin:14px 0 2px;background:#151a10;border:1px solid #354029;border-radius:6px;font-size:10px;overflow:hidden}.ds-evidence dl>div{display:flex}.ds-evidence dl>div+div{border-top:1px solid #354029}.ds-evidence dt{padding:9px 10px;width:58px;color:#98a688;flex-shrink:0;background:#1d2516}.ds-evidence dd{margin:0;padding:9px 10px;color:#d5dec9;overflow-wrap:anywhere}.ds-evidence p{margin:9px 0 0;font-size:10px;line-height:1.6;color:#abb69b}"
    },
    {
      "name": "Five-condition evidence gate",
      "kind": "custom",
      "description": "Static SVG specimen of the blocked 4/5 state; production renders the client-only Bklit Gauge.",
      "html": "<section class=\"ds-gate\" aria-label=\"4 of 5 evidence gates satisfied in the synthetic demo\"><div><h2>Evidence gate</h2><p>Benign regression blocks the draft.</p><strong>4 / 5 satisfied</strong></div><svg width=\"95\" height=\"54\" viewBox=\"0 0 95 70\" role=\"img\" aria-label=\"Four active notches, one inactive\"><g fill=\"var(--chart-1,#c7ef79)\"><path d=\"M14 33 22 19 29 23 21 37z\"/><path d=\"M29 10h19v8H29z\"/><path d=\"m54 18 10 14-7 5-10-14z\"/><path d=\"m8 43 8-3 7 17-8 3z\"/></g><path fill=\"var(--border,#34392e)\" d=\"m58 43 8-3 7 17-8 3z\"/></svg></section>",
      "css": ".ds-gate{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:20px;max-width:380px;border:1px solid var(--line,#32352f);border-radius:12px;background:#1a1d17;color:var(--ink,#f1f1eb);font-family:var(--font-public,'Public Sans'),sans-serif}.ds-gate h2{margin:0;font-size:13px;font-weight:600}.ds-gate p{font-size:10px;line-height:1.6;margin:6px 0;color:#aab59a}.ds-gate strong{font-size:11px;color:#c7dfac;font-variant-numeric:tabular-nums}.ds-gate svg{flex-shrink:0}"
    },
    {
      "name": "Agent node",
      "kind": "custom",
      "refersTo": "flow-agent",
      "description": "Static card specimen of a selectable React Flow agent node; the application owns the live routing and dragging.",
      "html": "<div class=\"ds-agent\" tabindex=\"0\"><div class=\"ds-agent-heading\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11\"/><path d=\"m9 12 2 2 4-4\"/></svg><span>Agent 3</span><i></i></div><strong>Development Security Agent</strong><p>Watch, test and verify</p><div class=\"ds-agent-footer\"><span>Run isolated checks</span><span>Planned</span></div><b class=\"ds-port ds-port-left\"></b><b class=\"ds-port ds-port-right\"></b></div>",
      "css": ".ds-agent{width:214px;min-height:152px;padding:17px 17px 0;background:#22291d;border:1px solid #536144;border-radius:10px;position:relative;color:var(--ink,#f1f1eb);font-family:var(--font-public,'Public Sans'),sans-serif}.ds-agent-heading{display:flex;align-items:center;gap:8px;color:#c9d9b7;margin-bottom:13px}.ds-agent-heading span{font-size:10px}.ds-agent-heading i{margin-left:auto;border:1px solid #a8ba94;width:6px;height:6px;border-radius:50%}.ds-agent>strong{display:block;font-size:16px;letter-spacing:-.025em;line-height:1.25;font-weight:600}.ds-agent>p{font-size:11px;color:#bac7ac;margin:7px 0 0;line-height:1.45}.ds-agent-footer{display:flex;justify-content:space-between;gap:5px;margin-top:16px;padding:10px 0;border-top:1px solid #46523b;color:#bac7ac;font-size:9px}.ds-agent-footer span:last-child{color:#d0dfbf}.ds-port{position:absolute;width:6px;height:6px;border:1px solid #181c16;background:#9daf8d;border-radius:50%;top:50%}.ds-port-left{left:-4px}.ds-port-right{right:-4px}.ds-agent:focus-visible{outline:2px solid #c7ef79;outline-offset:4px}"
    },
