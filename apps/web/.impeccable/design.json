      "css": ".ds-role-picker{display:flex;gap:6px;flex-wrap:wrap}.ds-role-picker button{border:1px solid #46513b;background:#1c2218;padding:8px 11px;border-radius:6px;font:11px var(--font-public,'Public Sans'),sans-serif;color:#b4c1a7;cursor:pointer}.ds-role-picker button[aria-pressed=true]{background:#303d24;border-color:#8fba60;color:#ddf8bc}.ds-role-picker button:hover{background:#303d24}.ds-role-picker button:focus-visible{outline:2px solid var(--blue,#c7ef79);outline-offset:4px}"
